{
  "name": "domain-driver",
  "version": "0.2.0",
  "description": "CLI scaffolding tool for domain-driven feature folders in Next.js, React, Node, and NestJS projects",
  "main": "index.js",
  "bin": {
    "domain-driver": "./dist/index.js"
  },
  "repository": {
    "type": "git",
